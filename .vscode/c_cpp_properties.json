{
    "configurations": [
        {
            "name": "ESP-IDF",
            "compilerPath": "${config:idf.toolsPathWin}\\tools\\xtensa-esp-elf\\esp-14.2.0_20251107\\xtensa-esp-elf\\bin\\xtensa-esp32-elf-gcc.exe",
            "compileCommands": "${config:idf.buildPath}/compile_commands.json",
            "includePath": [
                "${config:idf.espIdfPath}/components/**",
                "${config:idf.espIdfPathWin}/components/**",
                "${workspaceFolder}/**",
                "${workspaceFolder}/app/**",
                "${workspaceFolder}/app/app_client/**",
                "${workspaceFolder}/app/app_gpio/**",
                "${workspaceFolder}/app/app_helper/**",
                "${workspaceFolder}/app/app_server/**",
                "${workspaceFolder}/app/app_storage/**",
                "${workspaceFolder}/app/app_wifi/**",
                "${workspaceFolder}/port/port_system/**"
            ],
            "browse": {
                "path": [
                    "${config:idf.espIdfPath}/components",
                    "${config:idf.espIdfPathWin}/components",
                    "${workspaceFolder}",
                    "${workspaceFolder}/app",
                    "${workspaceFolder}/app/app_client",
                    "${workspaceFolder}/app/app_gpio",
                    "${workspaceFolder}/app/app_helper",
                    "${workspaceFolder}/app/app_server",
                    "${workspaceFolder}/app/app_storage",
                    "${workspaceFolder}/app/app_wifi",
                    "${workspaceFolder}/port/port_system"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}